BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

DATABASE_URL=sqlite:///./family_documents.db

JWT_SECRET=super-secret-family-document-vault-key-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

GOOGLE_FOLDER_ID=your-shared-folder-id-here

SYNC_POLL_INTERVAL_SECONDS=60

SYNC_BATCH_SIZE=50

HEALTH_CHECK_CACHE_TTL=30

# SMTP settings for sending password reset OTP emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false

# Resend API configuration for sending reset OTP emails
RESEND_API_KEY=


