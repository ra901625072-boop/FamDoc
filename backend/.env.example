# ==============================================================================
# FamDoc (FDMS) Backend Environment Variables
# Host: Railway (FastAPI) | Database: Supabase (PostgreSQL) | Frontend: Vercel
# ==============================================================================

# Core App Settings
BACKEND_URL=https://your-railway-app.up.railway.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database Connection (Supabase PostgreSQL)
# Option 1: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Option 2: Transaction Connection Pooler (Recommended for Serverless / Cloud, Port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Local Development Fallback:
DATABASE_URL=sqlite:///./family_documents.db

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Internal API Secret (for cron jobs or administrative retention triggers)
INTERNAL_API_SECRET=

# Google Drive Storage Integration (Primary Keepsake Storage Pool)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_FOLDER_ID=your-shared-folder-id-here

# Background Sync & Polling Settings
SYNC_POLL_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=50
HEALTH_CHECK_CACHE_TTL=30

# Password Reset Email Delivery (Resend API or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false
