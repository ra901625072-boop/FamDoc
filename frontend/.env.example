# FamDoc Modern Frontend Environment Variables
# Copy to frontend/.env.local for local overrides

# Base URL of the backend API (leave empty in local dev to use Vite proxy)
# In production on Cloudflare Pages, defaults to https://api.famdoc.com
VITE_API_BASE_URL=

# Local dev proxy target for /api requests (e.g. http://localhost:8000 or https://api.famdoc.com)
VITE_API_PROXY_TARGET=
