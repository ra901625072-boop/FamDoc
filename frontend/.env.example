# FamDoc Modern Frontend Environment Variables
# Copy to frontend/.env.local for local overrides or set in Vercel Project Settings

# Base URL of the FastAPI backend deployed on Railway
# Example: https://your-railway-app.up.railway.app
# Leave empty in local dev to use Vite proxy (default: http://localhost:8000)
VITE_API_BASE_URL=

# Local dev proxy target for /api requests (default: http://localhost:8000)
VITE_API_PROXY_TARGET=http://localhost:8000
